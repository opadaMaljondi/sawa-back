APP_NAME="Course Management System"
APP_ENV=local
APP_KEY=base64:Wqkoe6UxnjXROWk5yjO5IYpc+OsyqFVoCxR/4YZDUOo=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Admin dashboard (Vite) origin — required for wallet QR so scans open /students/:id?wallet=1 in the SPA, not on the API.
# Example local (see admin-dashboard/vite.config.js port): http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:3000

# Optional: override QR base only; defaults to ADMIN_DASHBOARD_URL then APP_URL
WALLET_QR_BASE_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=course_management
DB_USERNAME=course_user
DB_PASSWORD=Course//0951//

# نسخ احتياطي يومي (database:backup) — الافتراضي ~/backup (مجلد المستخدم/backup) وآخر 3 ملفات
DB_BACKUP_DIRECTORY=~/backup
DB_BACKUP_KEEP=3
# MYSQLDUMP_PATH=mysqldump
# رفع النسخ إلى Google Drive — الافتراضي OAuth عبر youtube-token.json (فعّل Google Drive API في نفس المشروع)
# DB_BACKUP_UPLOAD_TO_GOOGLE_DRIVE=true
# GOOGLE_DRIVE_AUTH=oauth
# GOOGLE_DRIVE_OAUTH_TOKEN_PATH=storage/app/youtube-token.json
# GOOGLE_DRIVE_FOLDER_ID=
# DB_BACKUP_GOOGLE_DRIVE_KEEP=3
# GOOGLE_DRIVE_SUPPORTS_ALL_DRIVES=false
# أو Service Account: GOOGLE_DRIVE_AUTH=service_account + GOOGLE_DRIVE_CREDENTIALS_PATH

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# YouTube uploads (OAuth): Enable "YouTube Data API v3" in Google Cloud Console, create OAuth client
# (Web application), add this exact redirect URI to the client. Then open APP_URL/youtube/auth once
# in a browser (same Google account as the channel) — token is saved to storage/app/youtube-token.json
YOUTUBE_CLIENT_ID=861501598602-oahro436do4htjrrt3ogjg3r89l8lqij.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=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
YOUTUBE_REDIRECT_URI=http://localhost:8000/youtube/callback
YOUTUBE_API_KEY=AIzaSyB2zfGGRYYFTxNf8dfZ9IWNogzFk9sVQ8s
YOUTUBE_CHANNEL_ID=UCBDEZMmfRXhBJj3Tfuu4DdA

# AWS S3 (video uploads when video_provider=aws; same disk as Laravel filesystems.s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher (للشات)
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Firebase (للإشعارات)
FCM_SERVER_KEY=

# SMS
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Email
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Video Encryption
VIDEO_ENCRYPTION_KEY=base64:your-32-byte-key-here
VIDEO_ENCRYPTION_CIPHER=AES-256-CBC

# Admin chunked video upload (local / S3). Each chunk must be under PHP upload_max_filesize / post_max_size.
VIDEO_CHUNK_MAX_KB=5120
VIDEO_MAX_KB=512000

# Device Limits
MAX_DEVICES_PER_ACCOUNT=3


ADMIN_NAME="مدير النظام"
ADMIN_EMAIL=admin@sawa.com
ADMIN_PHONE=123456789
ADMIN_PASSWORD=password


FIREBASE_CREDENTIALS=public/firebase.json
# Realtime Database URL (e.g. https://your-project-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=https://sawa-eb8d5-default-rtdb.firebaseio.com
FIREBASE_REALTIME_PREFIX=sawa
FIREBASE_REALTIME_CHAT_ENABLED=true
# Instructor → admin review alerts under {FIREBASE_REALTIME_PREFIX}/admin_alerts
FIREBASE_REALTIME_ADMIN_ALERTS_ENABLED=true
FIREBASE_FCM_ENABLED=true

